Перем Правила;
Перем ЧислоПроверок;

Процедура Проверить(Условие, Имя)
    Если Не Условие Тогда
        ВызватьИсключение "FAIL: " + Имя;
    КонецЕсли;
    ЧислоПроверок = ЧислоПроверок + 1;
    Сообщить("PASS: " + Имя);
КонецПроцедуры

Функция Строки(Товар, Количество)
    Результат = Новый Массив;
    Результат.Добавить(Новый Структура("Номенклатура,Количество", Товар, Количество));
    Возврат Результат;
КонецФункции

Процедура ЖдатьОшибку(Данные, Фрагмент)
    Получена = Ложь;
    Попытка
        Правила.СвернутьСтроки(Данные);
    Исключение
        Получена = СтрНайти(ОписаниеОшибки(), Фрагмент) > 0;
    КонецПопытки;
    Проверить(Получена, "Валидация: " + Фрагмент);
КонецПроцедуры

Правила = ЗагрузитьСценарий("src/CommonModules/СкладПравила/Ext/Module.bsl");
ЧислоПроверок = 0;
Данные = Строки("Кабель", 6);
Данные.Добавить(Новый Структура("Номенклатура,Количество", "Кабель", 6));
Данные.Добавить(Новый Структура("Номенклатура,Количество", "Мышь", 2));
Итог = Правила.СвернутьСтроки(Данные);
Проверить(Итог.Количество() = 2, "Повторяющиеся позиции свернуты");
Проверить(Итог[0].Количество = 12, "Проверяется суммарный расход, а не отдельные строки");
Проверить(Итог[1].Количество = 2, "Другой товар остается отдельным");
Проверить(Данные[0].Количество = 6, "Исходные данные не изменяются");
Данные = Строки("Кабель", 0.125);
Данные.Добавить(Новый Структура("Номенклатура,Количество", "Кабель", 0.375));
Проверить(Правила.СвернутьСтроки(Данные)[0].Количество = 0.5, "Дробные количества");
ЖдатьОшибку(Новый Массив, "хотя бы один товар");
ЖдатьОшибку(Строки("", 1), "не указан товар");
ЖдатьОшибку(Строки("Кабель", 0), "положительным");
ЖдатьОшибку(Строки("Кабель", -1), "положительным");
ЖдатьОшибку(Строки("Кабель", "6"), "числом");
ЖдатьОшибку(Строки("Кабель", 0.0001), "трех знаков");
Проверить(Правила.Дефицит(4, 10) = 6, "Расчет закупки до минимума");
Проверить(Правила.Дефицит(10, 10) = 0, "Ровно минимальный запас");
Проверить(Правила.Дефицит(20, 10) = 0, "Избыточный запас не дает отрицательную закупку");
ОшибкаПолучена = Ложь;
Попытка
    Правила.Дефицит(-1, 10);
Исключение
    ОшибкаПолучена = СтрНайти(ОписаниеОшибки(), "отрицательными") > 0;
КонецПопытки;
Проверить(ОшибкаПолучена, "Отрицательный остаток отклоняется");
Сообщить("OK: " + ЧислоПроверок + " проверок; исполнен исходный BSL-модуль.");
