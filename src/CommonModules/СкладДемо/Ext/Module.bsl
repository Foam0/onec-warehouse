#Область ПрограммныйИнтерфейс

Функция Заполнить() Экспорт
    Если Не РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение "Демоданные может создавать только администратор.";
    КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Склад = Справочники.Склады.НайтиПоКоду("DEMO-01");
        Если Не Склад.Пустая() Тогда
            ВызватьИсключение "Демоданные уже существуют. Используйте новую учебную базу.";
        КонецЕсли;
        Склад = СоздатьЭлемент(Справочники.Склады, "DEMO-01", "Основной склад");
        Магазин = СоздатьЭлемент(Справочники.Склады, "DEMO-02", "Магазин");
        Товар = СоздатьЭлемент(Справочники.Номенклатура, "DEMO-01", "Кабель USB-C");
        ОбъектТовара = Товар.ПолучитьОбъект();
        ОбъектТовара.МинимальныйОстаток = 10;
        ОбъектТовара.Записать();
        Поступление = СоздатьДокумент("ПоступлениеТоваров", Склад, Товар, 20);
        Расход = СоздатьДокумент("РасходТоваров", Склад, Товар, 6);
        Перемещение = СоздатьДокумент("ПеремещениеТоваров", Склад, Товар, 4, Магазин);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("Склад,Магазин,Товар,Поступление,Расход,Перемещение",
        Склад, Магазин, Товар, Поступление, Расход, Перемещение);
КонецФункции

Функция СоздатьДокумент(Имя, Склад, Товар, Количество, Получатель = Неопределено) Экспорт
    ДокументОбъект = Документы[Имя].СоздатьДокумент();
    ДокументОбъект.Дата = ТекущаяДатаСеанса();
    ДокументОбъект.Склад = Склад;
    Если Получатель <> Неопределено Тогда
        ДокументОбъект.СкладПолучатель = Получатель;
    КонецЕсли;
    СтрокаТовара = ДокументОбъект.Товары.Добавить();
    СтрокаТовара.Номенклатура = Товар;
    СтрокаТовара.Количество = Количество;
    ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
    Возврат ДокументОбъект.Ссылка;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьЭлемент(Менеджер, Код, Наименование)
    Элемент = Менеджер.СоздатьЭлемент();
    Элемент.Код = Код;
    Элемент.Наименование = Наименование;
    Элемент.Записать();
    Возврат Элемент.Ссылка;
КонецФункции

#КонецОбласти
