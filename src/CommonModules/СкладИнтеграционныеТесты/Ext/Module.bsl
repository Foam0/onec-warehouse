// Тестовые транзакции всегда откатываются, включая успешный сценарий.
// BSLLS:PairingBrokenTransaction-off
// BSLLS:WrongUseOfRollbackTransactionMethod-off
#Область ПрограммныйИнтерфейс

// Запускается кнопкой в чистой учебной базе. Успешные данные откатываются.
Процедура ПроверитьВсе() Экспорт
    НачатьТранзакцию();
    Попытка
        Демо = СкладДемо.Заполнить();
        Проверить(СкладУчет.Остаток(Демо.Склад, Демо.Товар) = 10, "Основной склад: 10");
        Проверить(СкладУчет.Остаток(Демо.Магазин, Демо.Товар) = 4, "Магазин: 4");
        Расход = Демо.Расход.ПолучитьОбъект();
        Расход.Записать(РежимЗаписиДокумента.Проведение);
        Проверить(СкладУчет.Остаток(Демо.Склад, Демо.Товар) = 10, "Перепроведение идемпотентно");
        Расход.Товары[0].Количество = 5;
        Расход.Записать(РежимЗаписиДокумента.Проведение);
        Проверить(СкладУчет.Остаток(Демо.Склад, Демо.Товар) = 11, "Изменение расхода");
        Расход.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Проверить(СкладУчет.Остаток(Демо.Склад, Демо.Товар) = 16, "Отмена расхода");
        ОтменитьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    // Каждый отрицательный сценарий имеет отдельную транзакцию: после ошибки
    // проведения предыдущая транзакция может быть помечена платформой к откату.
    ПроверитьЗапретДефицита();
    ПроверитьЗапретОтменыПоступления();
    Сообщить("Пройдено 7 интеграционных проверок. Данные тестов отменены.");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗапретДефицита()
    НачатьТранзакцию();
    Попытка
        Демо = СкладДемо.Заполнить();
        // Две одинаковые позиции по 6: отдельная проверка строк дала бы ложный успех.
        Расход = Документы.РасходТоваров.СоздатьДокумент();
        Расход.Дата = ТекущаяДатаСеанса();
        Расход.Склад = Демо.Склад;
        Для Индекс = 1 По 2 Цикл
            СтрокаТовара = Расход.Товары.Добавить();
            СтрокаТовара.Номенклатура = Демо.Товар;
            СтрокаТовара.Количество = 6;
        КонецЦикла;
        ОшибкаПолучена = Ложь;
        Попытка
            Расход.Записать(РежимЗаписиДокумента.Проведение);
        Исключение
            ОшибкаПолучена = СтрНайти(ОписаниеОшибки(), "Недостаточно товара") > 0;
        КонецПопытки;
        ОтменитьТранзакцию();
        Проверить(ОшибкаПолучена, "Дефицит по повторяющимся строкам должен быть отклонен");
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьЗапретОтменыПоступления()
    НачатьТранзакцию();
    Попытка
        Демо = СкладДемо.Заполнить();
        Поступление = Демо.Поступление.ПолучитьОбъект();
        ОшибкаПолучена = Ложь;
        Попытка
            Поступление.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Исключение
            ОшибкаПолучена = СтрНайти(ОписаниеОшибки(), "Недостаточно товара") > 0;
        КонецПопытки;
        ОтменитьТранзакцию();
        Проверить(ОшибкаПолучена, "Нельзя отменить уже использованное поступление");
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура Проверить(Условие, Сообщение)
    Если Не Условие Тогда
        ВызватьИсключение Сообщение;
    КонецЕсли;
КонецПроцедуры

#КонецОбласти
