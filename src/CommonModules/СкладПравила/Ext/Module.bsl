// Чистые правила: один и тот же модуль исполняется в 1С и в OneScript.
#Область ПрограммныйИнтерфейс

Функция СвернутьСтроки(СтрокиТоваров) Экспорт
    Если СтрокиТоваров.Количество() = 0 Тогда
        ВызватьИсключение "Добавьте хотя бы один товар.";
    КонецЕсли;
    Индекс = Новый Соответствие;
    Результат = Новый Массив;
    Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
        Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
            ВызватьИсключение "В строке не указан товар.";
        КонецЕсли;
        Если ТипЗнч(СтрокаТовара.Количество) <> Тип("Число") Тогда
            ВызватьИсключение "Количество должно быть числом.";
        КонецЕсли;
        Если СтрокаТовара.Количество <= 0 Тогда
            ВызватьИсключение "Количество должно быть положительным.";
        КонецЕсли;
        Если Окр(СтрокаТовара.Количество, 3) <> СтрокаТовара.Количество Тогда
            ВызватьИсключение "Количество: не более трех знаков после запятой.";
        КонецЕсли;
        СвернутаяСтрока = Индекс.Получить(СтрокаТовара.Номенклатура);
        Если СвернутаяСтрока = Неопределено Тогда
            СвернутаяСтрока = Новый Структура("Номенклатура,Количество", СтрокаТовара.Номенклатура, 0);
            Индекс.Вставить(СтрокаТовара.Номенклатура, СвернутаяСтрока);
            Результат.Добавить(СвернутаяСтрока);
        КонецЕсли;
        СвернутаяСтрока.Количество = СвернутаяСтрока.Количество + СтрокаТовара.Количество;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция Дефицит(Остаток, Минимум) Экспорт
    Если Остаток < 0 Или Минимум < 0 Тогда
        ВызватьИсключение "Остаток и минимум не могут быть отрицательными.";
    КонецЕсли;
    Возврат Макс(0, Минимум - Остаток);
КонецФункции

#КонецОбласти
