#Область ПрограммныйИнтерфейс

// Вызывается из ОбработкиПроведения, то есть внутри транзакции платформы.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - проводимый складской документ.
//  Операция - Строка - Поступление, Расход или Перемещение.
Процедура Провести(ДокументОбъект, Операция) Экспорт
    Если Не ЗначениеЗаполнено(ДокументОбъект.Склад) Тогда
        ВызватьИсключение "Укажите склад.";
    КонецЕсли;
    Если Операция = "Перемещение" Тогда
        Если Не ЗначениеЗаполнено(ДокументОбъект.СкладПолучатель) Тогда
            ВызватьИсключение "Укажите склад получатель.";
        КонецЕсли;
        Если ДокументОбъект.Склад = ДокументОбъект.СкладПолучатель Тогда
            ВызватьИсключение "Склады отправитель и получатель должны различаться.";
        КонецЕсли;
    КонецЕсли;
    Если ДокументОбъект.Дата > ТекущаяДатаСеанса() Тогда
        ВызватьИсключение "Проведение будущей датой не поддерживается.";
    КонецЕсли;
    СтрокиТоваров = СкладПравила.СвернутьСтроки(ДокументОбъект.Товары);
    ЗаблокироватьОстатки();
    Набор = ДокументОбъект.Движения.ОстаткиТоваров;
    Набор.Записывать = Истина;
    Набор.Очистить();
    Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
        Вид = ?(Операция = "Поступление", ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
        ДобавитьДвижение(Набор, ДокументОбъект.Дата, ДокументОбъект.Склад, СтрокаТовара, Вид);
        Если Операция = "Перемещение" Тогда
            ДобавитьДвижение(Набор, ДокументОбъект.Дата, ДокументОбъект.СкладПолучатель,
                СтрокаТовара, ВидДвиженияНакопления.Приход);
        КонецЕсли;
    КонецЦикла;
    // Замещаем старые движения до контроля. Перепроведение не удваивает расход.
    Набор.Записать();
    ПроверитьНеотрицательныеОстатки();
КонецПроцедуры

Процедура ОтменитьПроведение(ДокументОбъект) Экспорт
    ЗаблокироватьОстатки();
    ДокументОбъект.Движения.ОстаткиТоваров.Очистить();
    ДокументОбъект.Движения.ОстаткиТоваров.Записать();
    // Нельзя отменить поступление, если его товар уже израсходован.
    ПроверитьНеотрицательныеОстатки();
КонецПроцедуры

Функция Остаток(Склад, Номенклатура) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ЕСТЬNULL(СУММА(КоличествоОстаток), 0) КАК Количество
        |ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(,
        |    Склад = &Склад И Номенклатура = &Товар) КАК Остатки";
    Запрос.УстановитьПараметр("Склад", Склад);
    Запрос.УстановитьПараметр("Товар", Номенклатура);
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Количество;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаблокироватьОстатки()
    // Для небольшой учебной базы сериализуем весь регистр: это также покрывает
    // старые склад/товары при изменении уже проведенного документа.
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиТоваров");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ДобавитьДвижение(Набор, Период, Склад, СтрокаТовара, Вид)
    Движение = Набор.Добавить();
    Движение.Период = Период;
    Движение.ВидДвижения = Вид;
    Движение.Склад = Склад;
    Движение.Номенклатура = СтрокаТовара.Номенклатура;
    Движение.Количество = СтрокаТовара.Количество;
КонецПроцедуры

Процедура ПроверитьНеотрицательныеОстатки()
    Запрос = Новый Запрос;
    // Проверяем ВСЕ текущие остатки, включая старые измерения при перепроведении.
    // Отбор по новым товарам пропустил бы дефицит, созданный удаленной строкой.
    // BSLLS:VirtualTableCallWithoutParameters-off
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1 Склад КАК Склад, Номенклатура КАК Номенклатура,
        |    КоличествоОстаток КАК КоличествоОстаток
        |ИЗ РегистрНакопления.ОстаткиТоваров.Остатки() КАК Остатки
        |ГДЕ КоличествоОстаток < 0";
    // BSLLS:VirtualTableCallWithoutParameters-on
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        ВызватьИсключение СтрШаблон("Недостаточно товара %1 на складе %2. Дефицит: %3.",
            Выборка.Номенклатура, Выборка.Склад, -Выборка.КоличествоОстаток);
    КонецЕсли;
КонецПроцедуры

#КонецОбласти
